{
  "name": "abwab-digital-api",
  "version": "1.0.0",
  "description": "A comprehensive Node.js/Express REST API for Abwab Digital - a bilingual digital marketing company with complete CRM system",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "set NODE_ENV=development&& nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "build": "echo 'No build step required'",
    "seed": "node seed.js",
    "create-admin": "node createUser.js",
    "fix-images": "node fixImagePaths.js",
    "send-test-email": "node sendMail.js",
    "docker:build": "docker build -t abwab-digital-api .",
    "docker:run": "docker run -p 4000:4000 abwab-digital-api",
    "pm2:start": "pm2 start server.js --name abwab-digital-api",
    "pm2:stop": "pm2 stop abwab-digital-api",
    "pm2:restart": "pm2 restart abwab-digital-api",
    "pm2:logs": "pm2 logs abwab-digital-api",
    "vercel:deploy": "vercel --prod",
    "health-check": "curl -f http://localhost:4000/health || exit 1"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "api",
    "rest-api",
    "bilingual",
    "arabic",
    "english",
    "digital-marketing",
    "crm",
    "sales-management",
    "adminjs",
    "newsletter",
    "file-upload",
    "authentication",
    "jwt",
    "swagger"
  ],
  "author": "Abwab Digital Development Team",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/abwab-digital/abwab-digital-api.git"
  },
  "bugs": {
    "url": "https://github.com/abwab-digital/abwab-digital-api/issues"
  },
  "homepage": "https://github.com/abwab-digital/abwab-digital-api#readme",
  "dependencies": {
    "@adminjs/design-system": "^4.1.1",
    "@adminjs/express": "^6.1.0",
    "@adminjs/mongoose": "^4.1.0",
    "adminjs": "^7.8.4",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "body-parse": "^0.1.0",
    "bull": "^4.16.5",
    "celebrate": "^15.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.0.1",
    "fs": "^0.0.1-security",
    "helmet": "^8.0.0",
    "ioredis": "^5.7.0",
    "joi": "^17.13.3",
    "json5": "^2.2.3",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "luxon": "^3.7.2",
    "marked": "^12.0.0",
    "mongodb": "^6.3.0",
    "mongoose": "^8.1.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.12",
    "npm-modules": "^1.0.1",
    "pdf-lib": "^1.17.1",
    "pino": "^9.9.5",
    "pino-pretty": "^13.1.1",
    "pug": "^3.0.3",
    "qs": "^6.11.2",
    "redis": "^4.7.0",
    "sharp": "^0.33.4",
    "sitemap": "^8.0.0",
    "slug": "^8.2.3",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "validator": "^13.11.0",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "jest": "^29.0.0",
    "supertest": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "@types/jest": "^29.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.js", "**/?(*.)+(spec|test).js"],
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "services/**/*.js",
      "models/**/*.js",
      "middleware/**/*.js",
      "utils/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"]
  }
}
