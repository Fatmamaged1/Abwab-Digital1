# ===============================================
# ABWAB DIGITAL - BACKEND CONFIGURATION
# ===============================================
# ⚠️  IMPORTANT: Copy this to .env and change all values!
# ===============================================

# Server Configuration
NODE_ENV=development
PORT=4000
HTTP_PORT=8080

# Database Configuration
# Local MongoDB:
MONGO_URI=mongodb://localhost:27017/abwab_digital
# Or MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/abwab_digital

# JWT Configuration
# ⚠️  CRITICAL: Generate a strong random string!
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE_TIME=90d

# Session Configuration
# ⚠️  CRITICAL: Generate a strong random string!
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Google Generative AI Configuration (Optional)
GOOGLE_API_KEY=your-google-api-key-here

# Email Configuration (SMTP) - Optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-app-password

# CORS Configuration
FRONTEND_URL=http://localhost:3000
# Additional allowed origins (comma-separated, optional)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# SSL Configuration (for HTTPS in production)
# SSL_CERT_PATH=/etc/letsencrypt/live/backend.abwabdigital.com/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/backend.abwabdigital.com/privkey.pem

# Admin Configuration (for seed scripts)
# ⚠️  CRITICAL: Change before running seed.js!
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-secure-password

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
